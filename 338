class Solution {
    public int[] countBits(int n) {
        int[] ans = new int[n + 1];
        
        for (int i = 1; i <= n; i++) {
            // ans[i >> 1] has the bit count without the last bit;
            // (i & 1) adds 1 if the last bit is set (i is odd), or 0 if even.
            ans[i] = ans[i >> 1] + (i & 1);
        }
        
        return ans;
    }
}
